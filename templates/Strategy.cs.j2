		private void RefreshRiskMultiplier()
		{
			// throttle file reads to once per minute of bar time
			if ((Time[0] - lastRiskRead).TotalSeconds < 60)
				return;
			lastRiskRead = Time[0];

			try
			{
				if (string.IsNullOrEmpty(RiskFile) || !File.Exists(RiskFile))
				{
					riskMultiplier = 1.0;
					return;
				}
				string json = File.ReadAllText(RiskFile);
				double m = GetJsonNumber(json, "risk_multiplier", 1.0);
				riskMultiplier = (m > 0 && m <= 1.0) ? m : 1.0;
			}
			catch
			{
				riskMultiplier = 1.0; // fail safe: never upsize on a read error
			}
		}

		// minimal flat-JSON readers (no external NinjaScript references needed)
		private double GetJsonNumber(string json, string key, double fallback)
		{
			var m = Regex.Match(json, "\"" + Regex.Escape(key) + "\"\\s*:\\s*(-?[0-9]+(?:\\.[0-9]+)?)");
			return m.Success
				? double.Parse(m.Groups[1].Value, CultureInfo.InvariantCulture)
				: fallback;
		}

		private string GetJsonString(string json, string key, string fallback)
		{
			var m = Regex.Match(json, "\"" + Regex.Escape(key) + "\"\\s*:\\s*\"([^\"]*)\"");
			return m.Success ? m.Groups[1].Value : fallback;
		}
