# Copy to ".env" and fill in. NEVER commit the real .env.
# ── Market data ─────────────────────────────────────────────
FMP_API_KEY=your_financialmodelingprep_key_here

# ── Reporting bot (choose your platform) ────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Robinhood connector (Module 5: live execution) ──────────
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# TOTP secret (preferred) or the current 6-digit code
ROBINHOOD_MFA=

# ── Paths shared with NinjaTrader ───────────────────────────
# The strategy .cs file reads this JSON at session start.
# Point it at the NinjaTrader bin/Custom folder on the trading box.
NT_PARAM_FILE=./output/active_params.json
